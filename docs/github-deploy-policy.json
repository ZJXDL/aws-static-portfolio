{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyPortfolioBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::cloud-portfolio-577500259963"
    },
    {
      "Sid": "UploadAndRemovePortfolioFiles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::cloud-portfolio-577500259963/*"
    },
    {
      "Sid": "InvalidateOnlyPortfolioDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation"],
      "Resource": "arn:aws:cloudfront::577500259963:distribution/E2HQKB0TMNBJ3K"
    }
  ]
}
